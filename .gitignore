# PDFs do diário: 80 páginas por dia não cabem em repositório.
# Eles vivem como artifact do GitHub Actions (7 dias) e no destino final
# definido na Fase 3.
/dados/

# O texto extraido tambem nao: ele se refaz do PDF em segundos, e o que vale
# guardar e o que entra no banco.
/extraido/

# Configuracao com credencial. NUNCA versionar: e onde mora a senha do banco,
# e o modelo ao lado (config.exemplo.php) e o que se versiona no lugar.
/config/config.php

# O planejamento interno da SECTI (100 Dias, competencias do regimento) para a
# area restrita. Se o repositorio for aberto (DP-03), ele nao pode ir junto.
/config/interno.php

# Ambiente
.venv/
__pycache__/
*.pyc
.env

# Banco. O dump se regera em segundos a partir do JSONL, entao guardar 1,4 MB
# de binario no historico a cada carga nao paga.
/outputs/
*.sql.gz
!database/seed/*.sql

# Sistema e editores
.DS_Store
Thumbs.db
.idea/
.vscode/
